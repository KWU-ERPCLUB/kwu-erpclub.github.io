# 워크스페이스 백엔드 환경변수 — 이 파일은 "키 이름 문서"다(실값 금지·커밋 대상).
# 실제 값은 app/.env 에 넣는다(.gitignore로 추적 제외). 발급 절차 = ../supabase/README.md
#
# 값이 없으면? 오류 아님 — /workspace/ 가 "백엔드 연결 대기" 화면으로 뜨고 공개 페이지는 정상 동작.

# Supabase 프로젝트 URL (예: https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# anon(public) key — 브라우저에 노출되는 키. 방어선은 RLS(supabase/migrations/0002_rls.sql).
VITE_SUPABASE_ANON_KEY=

# service_role key는 여기에도, 이 저장소 어느 파일에도 넣지 않는다(SPEC §1 키 규칙·판정 P2).
# 서버 측 자동 발행 루틴이 필요할 때만 클라우드 루틴 환경변수로 보관한다.
